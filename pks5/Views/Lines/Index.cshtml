@model pks5.Controllers.LinesController.LinesVm

@{
    ViewData["Title"] = "Линии";
    var activeByLine = Model.ActiveOrders
        .Where(o => o.ProductionLineId != null)
        .GroupBy(o => o.ProductionLineId!.Value)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.Id).First());
}

<div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Производственные линии</h1>
        <div class="text-muted">Статус, текущий заказ и коэффициент эффективности.</div>
    </div>
</div>

<div class="row row-cols-1 row-cols-lg-2 g-3">
    @foreach (var line in Model.Lines)
    {
        activeByLine.TryGetValue(line.Id, out var order);

        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <h2 class="h5 mb-1">@line.Name</h2>
                            <div class="text-muted small">Текущий статус: <span class="fw-semibold">@line.Status</span></div>
                        </div>
                        <span class="badge @(line.Status == "Active" ? "text-bg-success" : "text-bg-secondary")">@line.Status</span>
                    </div>

                    <div class="mt-3">
                        <div class="small text-muted">Текущий продукт / заказ</div>
                        <div class="fw-semibold">@((order is null) ? "—" : $"{order.Product.Name} (#{order.Id})")</div>
                        @if (order is not null)
                        {
                            <div class="small text-muted">Прогресс: @order.ProgressPercent%</div>
                        }
                    </div>

                    <hr />

                    <form asp-action="Update" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@line.Id" />
                        <div class="col-6">
                            <label class="form-label mb-0">Статус</label>
                            <select class="form-select" name="status">
                                <option value="Active" selected="@(line.Status == "Active")">Active</option>
                                <option value="Stopped" selected="@(line.Status == "Stopped")">Stopped</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0">Эффективность</label>
                            <input class="form-control" type="number" step="0.01" min="0.5" max="2.0" name="efficiencyFactor" value="@line.EfficiencyFactor" />
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button class="btn btn-outline-primary" type="submit">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
